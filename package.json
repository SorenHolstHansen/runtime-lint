{
  "name": "runtime-lint-monorepo",
  "version": "0.0.0",
  "description": "Monorepo for runtime-lint and related projects",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "license": "MIT",
  "packageManager": "npm@10.2.0",
  "scripts": {
    "changeset:add": "changeset",
    "prechangeset:publish": "npm run build --prefix packages/runtime-lint",
    "changeset:publish": "changeset publish",
    "format": "npx @biomejs/biome check --write .",
    "test": "npm --prefix packages/runtime-lint run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SorenHolstHansen/runtime-lint.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.5"
  }
}
