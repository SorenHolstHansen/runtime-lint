{
  "name": "runtime-lint",
  "version": "0.2.4",
  "description": "A runtime \"linter\" for your js application.",
  "keywords": [
    "lint"
  ],
  "license": "MIT",
  "main": "dist/index.global.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SorenHolstHansen/runtime-lint.git",
    "directory": "packages/runtime-lint"
  },
  "bugs": {
    "url": "git+https://github.com/SorenHolstHansen/runtime-lint/issues"
  },
  "scripts": {
    "build:tsup": "NODE_ENV=production tsup",
    "build:css": "npx @tailwindcss/cli -i ./input.css -o ./src/output.css --minify",
    "build": "npm run build:css && npm run build:tsup",
    "dev:tsup": "NODE_ENV=development tsup --watch",
    "dev:css": "npx @tailwindcss/cli -i ./input.css -o ./src/output.css --watch",
    "dev": "npm-run-all --parallel dev:css dev:tsup",
    "start-api": "pm2 start test-api/api.js",
    "stop-api": "pm2 delete test-api/api.js",
    "test": "npm run start-api && sleep 1 && node --import tsx --test \"src/**/*.test.ts\" && npm run stop-api"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "object-scout": "^0.1.0",
    "preact": "^10.26.9",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.10",
    "@types/node": "^20.14.9",
    "express": "^4.19.2",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.10",
    "tsup": "^8.5.0",
    "tsx": "^4.15.7"
  },
  "include": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.global.js"
    },
    "./package.json": "./package.json"
  }
}
